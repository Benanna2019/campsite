{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src",
    "convex",
    "vite.config.ts",
    "vitest.config.ts",
    "alchemy.run.ts"
  ],
  "exclude": [
    "convex/_generated"
  ]
}
